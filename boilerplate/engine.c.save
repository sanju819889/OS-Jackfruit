#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <errno.h>
/* ===================== STRUCT ===================== */
typedef struct {
    int server_fd;
} supervisor_ctx_t;

/* ===================== CLIENT ===================== */
static int send_control_request(const char *msg)
{
    int sock;
    struct sockaddr_un addr;

    sock = socket(AF_UNIX, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("socket");
        return 1;
    }

    memset(&addr, 0, sizeof(addr));
    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, CONTROL_PATH, sizeof(addr.sun_path) - 1);

    if (connect(sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        perror("connect");
        close(sock);
        return 1;
    }

    write(sock, msg, strlen(msg));

    char buffer[BUFFER_SIZE];
    int n = read(sock, buffer, sizeof(buffer) - 1);
    if (n > 0) {
        buffer[n] = '\0';
        printf("%s\n", buffer);
    }

    close(sock);
    return 0;
}

/* ===================== SERVER ===================== */
static void handle_client(int client_fd)
{
    char buffer[BUFFER_SIZE];

    int n = read(client_fd, buffer, sizeof(buffer) - 1);
    if (n <= 0) {
        close(client_fd);
        return;
    }

    buffer[n] = '\0';

    printf("Received command: %s\n", buffer);

    char response[BUFFER_SIZE];
    snprintf(response, sizeof(response), "ACK: %s", buffer);

    write(client_fd, response, strlen(response));

    close(client_fd);
}

/* ===================== SUPERVISOR ===================== */
static int run_supervisor(const char *rootfs)
{
    supervisor_ctx_t ctx;

    ctx.server_fd = socket(AF_UNIX, SOCK_STREAM, 0);
    if (ctx.server_fd < 0) {
        perror("socket");
        return 1;
    }

    struct sockaddr_un addr;
    memset(&addr, 0, sizeof(addr));

    addr.sun_family = AF_UNIX;
    strncpy(addr.sun_path, CONTROL_PATH, sizeof(addr.sun_path) - 1);

    unlink(CONTROL_PATH);

    if (bind(ctx.server_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        perror("bind");
        return 1;
    }

    if (listen(ctx.server_fd, 5) < 0) {
        perror("listen");
        return 1;
    }

    printf("Supervisor running (rootfs: %s)\n", rootfs);

    while (1) {
        int client_fd = accept(ctx.server_fd, NULL, NULL);
        if (client_fd < 0) {
            perror("accept");
            continue;
        }

        printf("Client connected\n");
        handle_client(client_fd);
    }

    close(ctx.server_fd);
    unlink(CONTROL_PATH);

    return 0;
}

/* ===================== MAIN ===================== */
int main(int argc, char *argv[])
{
    if (argc < 2) {
        printf("Usage:\n");
        printf("  %s supervisor <base-rootfs>\n", argv[0]);
        printf("  %s <command>\n", argv[0]);
        return 1;
    }

    if (strcmp(argv[1], "supervisor") == 0) {
        if (argc < 3) {
            printf("Usage: %s supervisor <base-rootfs>\n", argv[0]);
            return 1;
        }
        return run_supervisor(argv[2]);
    }

    // send any command
    return send_control_request(argv[1]);
}
